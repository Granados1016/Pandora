# ══════════════════════════════════════════════════════════════════════════════
#  PANDORA — Variables de entorno para Docker
#  Copiar este archivo a .env y ajustar los valores
# ══════════════════════════════════════════════════════════════════════════════

# ── Puertos ───────────────────────────────────────────────────────────────────
APP_PORT=8080          # Puerto donde se sirve la app  → http://localhost:8080
DB_PORT=1433           # Puerto SQL Server (comentar en producción)

# ── Base de datos ─────────────────────────────────────────────────────────────
# IMPORTANTE: La contraseña debe tener mayúsculas, minúsculas, números y símbolo
DB_PASSWORD=PandoraAdmin2024!

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres — cambiar en producción
JWT_KEY=Pandora_SuperSecret_Docker_Key_2024_Min32Chars!

# ── Usuario administrador inicial ────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=PandoraAdmin2024!

# ── Biblioteca Virtual ────────────────────────────────────────────────────────
# Ruta HOST de la carpeta "Material Bibliografico" (relativa a docker-compose.yml)
# Ejemplo Windows: C:/Users/siste/OneDrive/Desktop/Proyeto_Pandora/Material Bibliografico
BIBLIOTECA_HOST_PATH=../Material Bibliografico
